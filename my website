<!-- ── Process ── -->
<section id="process">
  <div class="section-label">How We Work</div>
  <h2 class="section-title">From Onboarding to Ongoing Growth</h2>
  <p class="section-sub">A clear, repeatable process that removes uncertainty and keeps both sides aligned throughout the engagement.</p>
<div class="process-steps">
    <div class="process-step">
      <div class="step-num">01</div>
      <h3>Discovery Call</h3>
      <p>We learn your business, goals, current challenges, and competitive landscape before recommending anything.</p>
    </div>
    <div class="process-step">
      <div class="step-num">02</div>
