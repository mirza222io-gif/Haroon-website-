<!-- ── Nav ── -->
<nav id="main-nav">
  <a class="nav-logo" href="#">Haroon<span>.</span>Digital Lab</a>
  <ul class="nav-links" id="nav-links">
    <li><a href="#services">Services</a></li>
    <li><a href="#why">Why Us</a></li>
